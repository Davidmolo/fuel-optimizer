NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/fuel-optimizer

# Open Road TMS API V2
OPENROAD_API_BASE_URL=https://app.openroadtms.com/api/v2
OPENROAD_API_TOKEN=your-openroad-api-token

# Samsara API credentials are managed in Settings → Samsara (database).

# Relay Payments TMS Fuel API (relayPaymentId = API key)
RELAY_API_BASE_URL=https://app.relaypayments.com/api/integrations
RELAY_API_KEY_BLUE_STALLION=your-relay-api-key
RELAY_API_KEY_AZFS=your-relay-api-key

# Require X-User-Email header on protected routes (set true in production)
API_AUTH_REQUIRED=false

# Google Maps Platform — Routes API + Route Matrix API (required for road-based distances)
# Enable both APIs in Google Cloud Console and restrict the key to your backend.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
