{
  "name": "backend",
  "version": "1.0.0",
  "description": "Fuel Optimizer backend service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "cross-env APP_ENV=local nodemon --watch src --ext ts,json --exec tsx src/server.ts",
    "dev:prod": "cross-env APP_ENV=prod nodemon --watch src --ext ts,json --exec tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run start:local",
    "start:local": "cross-env APP_ENV=local node dist/server.js",
    "start:prod": "cross-env APP_ENV=prod node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:recommendations": "node scripts/test-recommendations.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "mongoose": "^9.6.3",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
